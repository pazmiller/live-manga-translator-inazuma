{
  "name": "manga-window-translator",
  "version": "1.1.0",
  "description": "Live manga translation for Windows",
  "main": "main.js",
  "scripts": {
    "start": "node run.js",
    "validate": "node scripts/validate.cjs",
    "validate:glass": "node scripts/validate.cjs --glass",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/run-electron.cjs renderer-smoke.cjs",
    "test:glass": "node tests/run-electron.cjs glass-smoke.cjs",
    "test:glass:app": "node tests/run-electron.cjs glass-app-smoke.cjs",
    "test:responsive": "node tests/run-electron.cjs glass-responsive.cjs",
    "test:input": "node tests/run-electron.cjs toolbar-input.cjs",
    "test:app:live": "node tests/run-electron.cjs app-smoke.cjs",
    "test:manga:startup": "node tests/run-electron.cjs manga-startup-smoke.cjs",
    "test:manga:ui": "node tests/run-electron.cjs manga-ui-live.cjs",
    "test:settings": "node tests/run-electron.cjs settings-ui.cjs",
    "dist:win": "node scripts/build-windows.cjs",
    "dist:win:manga": "node scripts/build-windows.cjs --manga",
    "test:packaged": "node tests/packaged-smoke.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.2",
    "electron-builder": "26.0.12"
  }
}
